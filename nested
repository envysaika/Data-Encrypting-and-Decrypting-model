n = int(input("Enter the maximum value to display: "))

for i in range(1, n + 1):
    if i == 1:
        print("1 = 1")
    else:
        temp = i
        factors_str = ""
        first_factor = 0
        has_different_factors = False

        for j in range(2, i + 1):
            while temp % j == 0:
                # Track unique prime factors
                if first_factor == 0:
                    first_factor = j
                elif j != first_factor:
                    has_different_factors = True

                
                if factors_str == "":
                    factors_str = str(j)
                else:
                    factors_str = factors_str + "x" + str(j)

                temp = temp // j

        
        if not has_different_factors:
            print(str(i) + " = " + str(first_factor) + " (prime)")
        else:
            print(str(i) + " = " + factors_str)
